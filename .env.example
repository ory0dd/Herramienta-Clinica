# Copia este archivo como .env (solo para probar en tu computadora).
# En Railway estas mismas variables van en la pestaña "Variables" del servicio.

# Supabase > Project Settings > API (o "API Keys")
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
# La llave pública: "anon public" o "publishable". NUNCA la "service_role" ni la "secret".
VITE_SUPABASE_ANON_KEY=pega-aqui-tu-llave-publica

# Opcional: el nombre de tu consultorio, como se ve en la app.
# VITE_NOMBRE_CONSULTORIO=Consultorio Ejemplo

# Opcional: botón "Continuar con Google" para consultantes (primero actívalo en Supabase; ver guía).
# VITE_ACCESO_GOOGLE=si

# Opcional: dominio interno de las cuentas de consultantes creadas con nombre de usuario (versiones anteriores).
# VITE_DOMINIO_USUARIOS=consultantes.local

# Asistente (Cloudflare Workers AI). Solo las lee el servidor (npm start); nunca llegan al navegador.
CF_ACCOUNT_ID=pega-aqui-tu-account-id
CF_API_TOKEN=pega-aqui-tu-token
# CF_MODELO=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CF_MODELO_AUDIO=@cf/openai/whisper-large-v3-turbo

# Solo si NO usas Supabase: una clave que se pedirá para usar el asistente.
# IA_CLAVE_ACCESO=una-clave-larga
